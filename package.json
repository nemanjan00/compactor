{
	"name": "@nemanjan00/compactor",
	"version": "0.1.7",
	"description": "Context management for coding agents: offload big tool results, collapse finished work into summaries with an index, compact with a summary that keeps what the rest needs, and find any of it again. Harness-neutral core, with an adapter for the pi coding agent.",
	"main": "src/index.js",
	"license": "MIT",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"agent",
		"context",
		"compaction",
		"llm"
	],
	"pi": {
		"extensions": [
			"./src/adapters/pi/index.js"
		]
	},
	"files": [
		"src",
		"!src/**/__tests__",
		"!src/utils/fixtures",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"test": "jest",
		"test:watch": "jest --watch",
		"lint": "eslint src/ bench/",
		"prepare": "husky",
		"bench": "node bench/pi"
	},
	"jest": {
		"testEnvironment": "node",
		"forceExit": true
	},
	"lint-staged": {
		"*.js": "eslint --fix"
	},
	"peerDependencies": {
		"typebox": "*"
	},
	"devDependencies": {
		"@babel/core": "^8.0.7",
		"@babel/eslint-parser": "^8.0.7",
		"@eslint/js": "^10.0.1",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"lint-staged": "^17.6.0",
		"typebox": "^1.3.37"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nemanjan00/compactor.git"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependenciesMeta": {
		"typebox": {
			"optional": true
		}
	},
	"author": "Nemanja Nedeljkovic",
	"homepage": "https://github.com/nemanjan00/compactor#readme",
	"bugs": {
		"url": "https://github.com/nemanjan00/compactor/issues"
	}
}
